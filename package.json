{
  "name": "@vygruppen/spor-monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prebuild": "rimraf packages/*/dist --glob",
    "postinstall": "pnpm --filter @vygruppen/eslint-config build",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "dev": "pnpm --parallel --filter '@vygruppen/designmanual-frontend...' --filter '@vygruppen/designmanual' run dev",
    "storybook": "pnpm --filter './apps/storybook' storybook",
    "lint": "pnpm -r run lint --max-warnings=0",
    "changeset": "changeset",
    "prerelease": "pnpm build",
    "release": "changeset publish",
    "format:fix": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:validate": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css}\""
  },
  "dependencies": {
    "@changesets/cli": "^2.27.5",
    "@vygruppen/eslint-config": "workspace:*",
    "eslint": "^9.39.1",
    "jscodeshift": "^17.3.0",
    "prettier": "^3.3.1",
    "react-icons": "^5.4.0",
    "rimraf": "^5.0.7"
  },
  "engines": {
    "node": "22.23.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.3",
      "onFail": "download"
    }
  },
  "prettier": {},
  "packageManager": "pnpm@12.10.1"
}
