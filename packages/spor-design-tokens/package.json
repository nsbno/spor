{
  "name": "@vygruppen/spor-design-tokens",
  "version": "8.0.0",
  "description": "All Vy's design tokens",
  "type": "module",
  "homepage": "https://github.com/nsbno/spor/tree/main/packages/spor-card-react",
  "repository": {
    "type": "git",
    "url": "https://github.com/nsbno/spor.git",
    "directory": "packages/spor-design-tokens"
  },
  "exports": {
    ".": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.mjs",
      "require": "./dist/tokens.js"
    },
    "./raw-tokens": {
      "types": "./dist/raw-tokens/index.d.ts",
      "default": "./dist/raw-tokens/index.js"
    },
    "./react-native": {
      "types": "./react-native/index.d.ts",
      "import": "./react-native/index.mjs",
      "require": "./react-native/index.js"
    },
    "./tokens.json": "./dist/tokens.json",
    "./tokens.css": "./dist/tokens.css"
  },
  "scripts": {
    "build": "node scripts/build.mts",
    "prepare": "pnpm build",
    "dev": "node --watch-path=scripts --watch-path=tokens scripts/build.mts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "assets",
    "react-native",
    "tokens"
  ],
  "sideEffects": false,
  "license": "MIT",
  "devDependencies": {
    "@types/node": "catalog:",
    "@vygruppen/eslint-config": "workspace:*",
    "eslint": "^9.39.1",
    "json-to-ts": "^1.7.0",
    "style-dictionary": "^4.3.3",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}
