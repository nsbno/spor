{
  "extends": "../../tsconfig.react.json",
  "include": [
    "env.d.ts",
    "types.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "vite.config.mts",
    ".react-router/types/**/*"
  ],
  "exclude": ["oxlint.config.ts"],
  "compilerOptions": {
    "types": ["vite/client", "@react-router/node"],
    "rootDirs": [".", "./.react-router/types"],
    "resolveJsonModule": true,
    "paths": {
      "~/*": ["./app/*"]
    },
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  }
}
