{
  "extends": "../../tsconfig.react-library.json",
  "include": ["."],
  // tmp/ is generated by bin/generate.ts and only bundled by tsup.
  "exclude": ["dist", "node_modules", "tmp"],
  "compilerOptions": {
    // bin/generate.ts runs directly under Node's type stripping, which requires
    // explicit .ts extensions and `import type` for type-only imports.
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true
  }
}
