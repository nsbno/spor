{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Library",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Pins the syntax level of the published tsup output. `lib` stays ESNext
    // from the base, since it only affects type-checking and esbuild ignores it.
    "target": "es2024"
  }
}
