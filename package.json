{
  "name": "@vygruppen/spor-monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prebuild": "rm -rf packages/*/dist",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "dev": "pnpm -r --workspace-concurrency=16 run dev",
    "storybook": "pnpm --filter @vygruppen/spor-storybook run storybook",
    "lint": "pnpm -r run lint --max-warnings=0",
    "changeset": "npx changeset",
    "prerelease": "pnpm build",
    "release": "changeset publish",
    "format:fix": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:validate": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css}\""
  },
  "dependencies": {
    "@changesets/cli": "^2.27.5",
    "@vygruppen/eslint-config": "workspace:*",
    "eslint": "^9.39.1",
    "jscodeshift": "^17.3.0",
    "prettier": "^3.3.1",
    "react-icons": "^5.4.0"
  },
  "engines": {
    "node": "22.23.4"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.4",
      "onFail": "download"
    }
  },
  "prettier": {},
  "packageManager": "pnpm@12.16.0"
}
