{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Library",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Libraries built with tsup emit ES2022 syntax. The esbuild bundled with
    // tsup 7 doesn't recognise newer targets. `lib` is inherited (ESNext), since
    // it only affects type-checking and esbuild ignores it.
    "module": "ES2022",
    "target": "es2022"
  }
}
