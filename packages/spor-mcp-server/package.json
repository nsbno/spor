{
  "name": "@vygruppen/spor-mcp-server",
  "version": "2.2.12",
  "description": "MCP server for Spor Design System",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "spor-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test:smoke": "pnpm build && node dist/sdk-client.js",
    "inspect": "pnpm build && pnpm dlx @modelcontextprotocol/inspector node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "spor",
    "design-system"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@vygruppen/spor-design-tokens": "workspace:*",
    "@vygruppen/spor-react": "workspace:*",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native": "catalog:"
  }
}
