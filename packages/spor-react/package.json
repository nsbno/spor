{
  "name": "@vygruppen/spor-react",
  "type": "module",
  "version": "14.2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.mjs",
      "require": "./dist/icons/index.cjs"
    }
  },
  "license": "MIT",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "concurrently \"tsup --watch\" \"npx @chakra-ui/cli typegen src/theme/index.ts --watch\"",
    "postinstall": "chakra typegen src/theme/index.ts",
    "typegen": "npx @chakra-ui/cli typegen src/theme/index.ts",
    "typegen:watch": "npx @chakra-ui/cli typegen src/theme/index.ts --watch",
    "typegen:strict": "npx @chakra-ui/cli typegen /src/theme/index.ts --strict",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "homepage": "https://github.com/nsbno/spor/tree/main/packages/spor-react",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nsbno/spor.git",
    "directory": "packages/spor-react"
  },
  "dependencies": {
    "@ark-ui/react": "^4.9.2",
    "@chakra-ui/anatomy": "^2.3.4",
    "@chakra-ui/cli": "catalog:",
    "@chakra-ui/react": "catalog:",
    "@chakra-ui/react-use-size": "^2.1.0",
    "@chakra-ui/styled-system": "^2.12.0",
    "@chakra-ui/system": "^2.6.2",
    "@chakra-ui/theme": "^3.4.6",
    "@chakra-ui/theme-tools": "^2.2.6",
    "@chakra-ui/utils": "^2.2.2",
    "@emotion/styled": "^11.14.1",
    "@internationalized/date": "^3.6.0",
    "@react-types/datepicker": "^3.10.0",
    "@react-types/shared": "catalog:",
    "@vygruppen/spor-design-tokens": "workspace:*",
    "@vygruppen/spor-icon-react": "workspace:*",
    "@vygruppen/spor-loader": "workspace:*",
    "awesome-phonenumber": "^5.11.0",
    "deepmerge": "^4.3.1",
    "framer-motion": "^11.11.17",
    "lottie-react": "catalog:",
    "next-themes": "catalog:",
    "react-aria": "catalog:",
    "react-icons": "^5.4.0",
    "react-stately": "catalog:",
    "react-swipeable": "catalog:",
    "usehooks-ts": "catalog:"
  },
  "devDependencies": {
    "@emotion/react": "catalog:",
    "@storybook/react": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.0.2",
    "@vygruppen/eslint-config": "workspace:*",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  }
}
