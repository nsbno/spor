{
  "extends": "../../tsconfig.react.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "noFallthroughCasesInSwitch": true
  },
  // tsc skips dot-directories unless they are matched by a wildcard. The stories
  // themselves live in spor-react and are type-checked there.
  "include": [".storybook/**/*"]
}
