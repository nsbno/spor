{
  "name": "@vygruppen/spor-codemods",
  "version": "1.2.5",
  "description": "Code modification scripts for migrating Spor code to newer versions",
  "type": "module",
  "bin": {
    "spor-codemod": "./bin/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./transforms/*": "./transforms/*"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit"
  },
  "homepage": "https://github.com/nsbno/spor/tree/main/packages/spor-codemods",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nsbno/spor.git",
    "directory": "packages/spor-codemods"
  },
  "license": "MIT",
  "dependencies": {
    "jscodeshift": "catalog:"
  },
  "devDependencies": {
    "@vygruppen/oxlint-config": "workspace:*",
    "@types/jscodeshift": "catalog:",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
