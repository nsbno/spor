{
  "extends": "../../tsconfig.react.json",
  "include": ["."],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "rootDir": ".",
    // The build scripts run directly under Node's type stripping, which requires
    // explicit .ts extensions and `import type` for type-only imports.
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true
  }
}
